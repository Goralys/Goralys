{
    "name": "goralys/goralys",
    "description": "A simple web app to help french high-schools to manage subjects for the 'Grand Oral'",
    "license": [
        "AGPL-3.0-or-later"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "native/template-renderer",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.5.0",
        "ext-json": "*",
        "ext-mysqli": "*",
        "vlucas/phpdotenv": "^5.8",
        "ext-zip": "*",
        "ext-fileinfo": "*",
        "phpmailer/phpmailer": "^7.1",
        "goralys/template-renderer": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Goralys\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goralys\\Tests\\": "./tests"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "phpunit": "vendor/bin/phpunit",
        "phpcs": [
            "phpcs --standard=phpcs.xml ."
        ],
        "phpcbf": [
            "phpcbf --standard=phpcs.xml ."
        ]
    }
}
