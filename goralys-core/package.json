{
    "name": "@goralys/core",
    "version": "1.6.4",
    "license": "LGPL-2.1-or-later",
    "description": "Shared business logic for the Goralys web application",
    "repository": {
        "type": "git",
        "url": "https://github.com/SAMSAM-55/Goralys",
        "directory": "goralys-core"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prebuild": "pnpm barrel",
        "build": "tsup",
        "typeCheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
        "dev": "tsup --watch",
        "barrel": "node -e \"require('fs').rmSync('./src/index.ts',{force:true})\" && barrelsby -d ./src -l top"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "typescript": "^6.0.3",
        "typescript-native": "npm:typescript@^7.0.2",
        "barrelsby": "^2.8.1",
        "esbuild-plugin-tsconfig-paths": "^1.0.2",
        "react": "^18.0.0",
        "tsup": "^8.0.0"
    }
}
