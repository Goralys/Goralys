{
    "name": "@goralys/ui",
    "version": "0.1.1",
    "license": "LGPL-2.1-or-later",
    "description": "Shared React UI components for Goralys web and mobile apps",
    "repository": {
        "type": "git",
        "url": "https://github.com/SAMSAM-55/Goralys",
        "directory": "goralys-ui"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "imports": {
        "#lib/*": "./src/*"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prebuild": "pnpm barrel",
        "build": "tsup",
        "typeCheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
        "dev": "tsup --watch",
        "barrel": "node -e \"require('fs').rmSync('./src/index.ts',{force:true})\" && barrelsby -d ./src -l top"
    },
    "dependencies": {
        "@heroicons/react": "^2.2.0",
        "clsx": "^2.1.1",
        "@goralys/core": "workspace:^1.6.5"
    },
    "peerDependencies": {
        "react": ">=19",
        "react-dom": ">=19"
    },
    "devDependencies": {
        "typescript": "^6.0.3",
        "typescript-native": "npm:typescript@^7.0.2",
        "barrelsby": "^2.8.1",
        "esbuild-plugin-tsconfig-paths": "^1.0.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "tsup": "^8.0.0"
    }
}
